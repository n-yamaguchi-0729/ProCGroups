import ProCGroups.ProP.FrattiniPowers

set_option autoImplicit false
/-!
# The power--commutator quotient

This file exposes the quotient by the closed subgroup generated by `p`th
powers and commutators.  The quotient is commutative and has exponent dividing
`p`.  These facts are the algebraic input for the pro-`p` Frattini quotient;
no equality with the Frattini subgroup is assumed.
-/

namespace ClassFieldTower.ProP

universe u

section

variable (p : ℕ) (G : Type u) [TopologicalSpace G] [Group G] [IsTopologicalGroup G]

/- A single canonical local normality route supplies every quotient operation
in this file without exporting a competing global instance. -/
local instance : (closedPowerCommutator p G).Normal :=
  closedPowerCommutator_normal p G

/-- The quotient by the closed subgroup generated by `p`th powers and commutators. -/
abbrev powerCommutatorQuotient :=
  G ⧸ closedPowerCommutator p G

/-- The continuous quotient map to the power--commutator quotient. -/
def powerCommutatorQuotientMk :
    G →ₜ* powerCommutatorQuotient p G :=
  { toMonoidHom := QuotientGroup.mk' (closedPowerCommutator p G)
    continuous_toFun := QuotientGroup.continuous_mk }

/-- The canonical map to the power--commutator quotient is surjective. -/
theorem powerCommutatorQuotientMk_surjective :
    Function.Surjective (powerCommutatorQuotientMk p G) :=
  QuotientGroup.mk'_surjective (closedPowerCommutator p G)

/-- The kernel of the quotient map is the closed power--commutator subgroup. -/
theorem ker_powerCommutatorQuotientMk :
    (powerCommutatorQuotientMk p G).ker = closedPowerCommutator p G :=
  QuotientGroup.ker_mk' (closedPowerCommutator p G)

/-- The power--commutator quotient is commutative. -/
theorem powerCommutatorQuotient_isMulCommutative :
    IsMulCommutative (powerCommutatorQuotient p G) :=
  Subgroup.Normal.quotient_commutative_iff_commutator_le.mpr
    (commutator_le_closedPowerCommutator p G)

/-- Every element of the power--commutator quotient has `p`th power one. -/
theorem powerCommutatorQuotient_pow_eq_one
    (x : powerCommutatorQuotient p G) : x ^ p = 1 := by
  obtain ⟨g, rfl⟩ := QuotientGroup.mk'_surjective (closedPowerCommutator p G) x
  rw [← map_pow]
  change ((g ^ p : G) : G ⧸ closedPowerCommutator p G) = 1
  rw [QuotientGroup.eq_one_iff]
  exact pow_mem_closedPowerCommutator p G g

/-- Multiplication in the power--commutator quotient is commutative. -/
theorem powerCommutatorQuotient_mul_comm
    (x y : powerCommutatorQuotient p G) : x * y = y * x := by
  let : IsMulCommutative (powerCommutatorQuotient p G) :=
    powerCommutatorQuotient_isMulCommutative p G
  exact mul_comm' x y

end

end ClassFieldTower.ProP
