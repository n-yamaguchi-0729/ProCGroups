import ProCGroups.Topologies.TopologicallyCharacteristicSubgroups

set_option autoImplicit false
/-!
# Power--commutator core of the pro-p Frattini subgroup

This file constructs the closed subgroup generated by all `p`th powers and all
commutators.  It is the concrete side of the pro-`p` Frattini formula; the
identification with `frattini G` will require the pro-`p` maximal-subgroup
argument and is deliberately not assumed here.
-/

open Set

namespace ClassFieldTower.ProP

universe u

section Algebraic

variable (p : ℕ) (G : Type u) [Group G]

/-- The algebraic subgroup generated by all `p`th powers in `G`. -/
def powerSubgroup : Subgroup G :=
  Subgroup.closure (Set.range fun g : G => g ^ p)

/-- Every `p`th power belongs to the subgroup generated by the `p`th powers. -/
theorem pow_mem_powerSubgroup (g : G) : g ^ p ∈ powerSubgroup p G :=
  Subgroup.subset_closure ⟨g, rfl⟩

/-- Homomorphisms carry the `p`-power subgroup into the `p`-power subgroup. -/
theorem powerSubgroup_map_le
    {H : Type*} [Group H] (f : G →* H) :
    (powerSubgroup p G).map f ≤ powerSubgroup p H := by
  rw [powerSubgroup, MonoidHom.map_closure, Subgroup.closure_le]
  rintro _ ⟨_, ⟨g, rfl⟩, rfl⟩
  rw [map_pow]
  exact pow_mem_powerSubgroup p H (f g)

end Algebraic

section Characteristic

variable (p : ℕ) (G : Type u) [TopologicalSpace G] [Group G]

/-- The `p`-power subgroup is fixed by every continuous automorphism. -/
theorem powerSubgroup_topologicallyCharacteristic :
    (powerSubgroup p G).TopologicallyCharacteristic := by
  rw [Subgroup.topologicallyCharacteristic_iff_map_eq]
  intro e
  rw [powerSubgroup, MonoidHom.map_closure]
  congr 1
  ext x
  constructor
  · rintro ⟨_, ⟨g, rfl⟩, rfl⟩
    refine ⟨e g, ?_⟩
    exact (map_pow e.toMonoidHom g p).symm
  · rintro ⟨g, rfl⟩
    refine ⟨(e.symm g) ^ p, ⟨e.symm g, rfl⟩, ?_⟩
    calc
      e.toMonoidHom ((e.symm g) ^ p) = (e.toMonoidHom (e.symm g)) ^ p :=
        map_pow e.toMonoidHom (e.symm g) p
      _ = g ^ p := congrArg (fun x : G => x ^ p) (e.apply_symm_apply g)

end Characteristic

section Topological

variable (p : ℕ) (G : Type u) [TopologicalSpace G] [Group G] [IsTopologicalGroup G]

/-- The closed subgroup generated by the `p`th powers and the commutator subgroup. -/
def closedPowerCommutator : Subgroup G :=
  (powerSubgroup p G ⊔ commutator G).topologicalClosure

/-- The closed power--commutator subgroup is topologically characteristic. -/
theorem closedPowerCommutator_topologicallyCharacteristic :
    (closedPowerCommutator p G).TopologicallyCharacteristic := by
  apply Subgroup.TopologicallyCharacteristic.topologicalClosure
  apply Subgroup.TopologicallyCharacteristic.sup
  · exact powerSubgroup_topologicallyCharacteristic p G
  · infer_instance

/-- The closed power--commutator subgroup is topologically closed. -/
theorem isClosed_closedPowerCommutator :
    IsClosed (closedPowerCommutator p G : Set G) :=
  Subgroup.isClosed_topologicalClosure _

/-- The algebraic `p`-power subgroup lies in the closed power--commutator subgroup. -/
theorem powerSubgroup_le_closedPowerCommutator :
    powerSubgroup p G ≤ closedPowerCommutator p G :=
  le_trans le_sup_left (Subgroup.le_topologicalClosure _)

/-- The commutator subgroup lies in the closed power--commutator subgroup. -/
theorem commutator_le_closedPowerCommutator :
    commutator G ≤ closedPowerCommutator p G :=
  le_trans le_sup_right (Subgroup.le_topologicalClosure _)

/-- Every `p`th power lies in the closed power--commutator subgroup. -/
theorem pow_mem_closedPowerCommutator (g : G) :
    g ^ p ∈ closedPowerCommutator p G :=
  powerSubgroup_le_closedPowerCommutator p G (pow_mem_powerSubgroup p G g)

/-- The closed power--commutator subgroup is normal. -/
theorem closedPowerCommutator_normal :
    (closedPowerCommutator p G).Normal := by
  let : (closedPowerCommutator p G).TopologicallyCharacteristic :=
    closedPowerCommutator_topologicallyCharacteristic p G
  infer_instance

/-- Continuous homomorphisms preserve the closed power--commutator filtration term. -/
theorem closedPowerCommutator_map_le
    {H : Type*} [TopologicalSpace H] [Group H] [IsTopologicalGroup H]
    (f : G →ₜ* H) :
    (closedPowerCommutator p G).map f.toMonoidHom ≤ closedPowerCommutator p H := by
  apply Subgroup.map_topologicalClosure_le_of_map_le f.continuous_toFun
  · rw [Subgroup.map_sup]
    apply sup_le
    · exact (powerSubgroup_map_le p G f.toMonoidHom).trans
        (powerSubgroup_le_closedPowerCommutator p H)
    · have hcomm : (commutator G).map f.toMonoidHom ≤ commutator H := by
        rw [_root_.map_commutator_eq]
        exact Subgroup.commutator_mono le_top le_top
      exact hcomm.trans (commutator_le_closedPowerCommutator p H)
  · exact isClosed_closedPowerCommutator p H

end Topological

end ClassFieldTower.ProP
