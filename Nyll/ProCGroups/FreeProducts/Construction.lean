module

public import Mathlib.Algebra.Group.TransferInstance
public import Mathlib.Topology.Algebra.ContinuousMonoidHom
public import Mathlib.Topology.Algebra.Group.ClosedSubgroup
public import Nyll.ProCGroups.FiniteGroups.Classes
public import Nyll.ProCGroups.FreeProducts.UniversalProperty
public import Nyll.ProCGroups.Generation.Basic
public import Nyll.ProCGroups.ProC.InverseLimits.ContinuousExtensions
public import Nyll.ProCGroups.ProC.Subgroups.Products

/-!
# Construction of binary free pro-C products

The finite stages are all pairs of continuous homomorphisms from the given factors to a
finite group in `C`. Using fixed finite carriers makes their collection small. The closed
subgroup generated by the two evaluation maps in the product of these stages is the free
pro-C product. In particular, the original topologies of the factors are retained.

Formation and hereditary closure ensure that this closed subgroup is pro-C. Coordinate
projections solve each finite extension problem; topological generation proves uniqueness.
The finite-quotient extension theorem then gives the full universal property, including
targets in independent universes through the API of `IsFreeProCProduct`.
-/

@[expose] public section

namespace ProCGroups.FreeProducts

universe u v

namespace Construction

/-- A small collection of carriers representing every finite group in the native universe. -/
structure FiniteModel where
  /-- The cardinality of the chosen carrier. -/
  card : ℕ
  /-- The group law on that carrier. -/
  group : Group (ULift.{u} (Fin card))

/-- The carrier keeps the chosen finite group law separate from ambient lifted instances. -/
def FiniteModel.Carrier (Q : FiniteModel.{u}) : Type u := ULift.{u} (Fin Q.card)

instance : CoeSort FiniteModel.{u} (Type u) where
  coe := FiniteModel.Carrier

instance (Q : FiniteModel.{u}) : Group Q := Q.group

instance (Q : FiniteModel.{u}) : Finite Q :=
  inferInstanceAs (Finite (ULift.{u} (Fin Q.card)))

instance (Q : FiniteModel.{u}) : TopologicalSpace Q := ⊥

instance (Q : FiniteModel.{u}) : DiscreteTopology Q := ⟨rfl⟩

variable (C : FiniteGroupClass.{u})
variable (G₁ G₂ : Type u) [Group G₁] [TopologicalSpace G₁]
  [Group G₂] [TopologicalSpace G₂]

/-- A finite in-class continuous two-factor diagram; no topology on either factor is changed. -/
structure FiniteDiagram where
  /-- The represented finite target. -/
  target : FiniteModel.{u}
  /-- The target belongs to the specified finite-group class. -/
  inClass : C target
  /-- The continuous map from the first factor. -/
  left : G₁ →ₜ* target
  /-- The continuous map from the second factor. -/
  right : G₂ →ₜ* target

/-- The product of all finite continuous two-factor diagrams. -/
abbrev StageProduct : Type u := (d : FiniteDiagram C G₁ G₂) → d.target

/-- Evaluation of the first factor at every finite diagram. -/
def evaluationLeft : G₁ →ₜ* StageProduct C G₁ G₂ where
  toFun x d := d.left x
  map_one' := by
    funext d
    exact d.left.map_one
  map_mul' x y := by
    funext d
    exact d.left.map_mul x y
  continuous_toFun := continuous_pi fun d => d.left.continuous

/-- Evaluation of the second factor at every finite diagram. -/
def evaluationRight : G₂ →ₜ* StageProduct C G₁ G₂ where
  toFun x d := d.right x
  map_one' := by
    funext d
    exact d.right.map_one
  map_mul' x y := by
    funext d
    exact d.right.map_mul x y
  continuous_toFun := continuous_pi fun d => d.right.continuous

/-- The family containing both factor evaluations. -/
def generators : G₁ ⊕ G₂ → StageProduct C G₁ G₂ :=
  Sum.elim (evaluationLeft C G₁ G₂) (evaluationRight C G₁ G₂)

/-- The actual closed subgroup used to construct the free product. -/
def generatedSubgroup : ClosedSubgroup (StageProduct C G₁ G₂) :=
  Generation.closedSubgroupGenerated (Set.range (generators C G₁ G₂))

end Construction

variable (C : FiniteGroupClass.{u})
variable (G₁ G₂ : Type u) [Group G₁] [TopologicalSpace G₁]
  [Group G₂] [TopologicalSpace G₂]

/-- The binary free pro-C product, constructed from finite continuous diagrams. -/
abbrev FreeProduct : Type u :=
  (Construction.generatedSubgroup C G₁ G₂ : Subgroup (Construction.StageProduct C G₁ G₂))

instance : CompactSpace (FreeProduct C G₁ G₂) :=
  inferInstanceAs (CompactSpace (Construction.generatedSubgroup C G₁ G₂))

/-- The continuous map of the first factor into the constructed free product. -/
def inl : G₁ →ₜ* FreeProduct C G₁ G₂ where
  toFun x := Generation.closedSubgroupGeneratedMap
    (Construction.generators C G₁ G₂) (Sum.inl x)
  map_one' := Subtype.ext (Construction.evaluationLeft C G₁ G₂).map_one
  map_mul' x y := Subtype.ext ((Construction.evaluationLeft C G₁ G₂).map_mul x y)
  continuous_toFun := (Construction.evaluationLeft C G₁ G₂).continuous.subtype_mk _

/-- The continuous map of the second factor into the constructed free product. -/
def inr : G₂ →ₜ* FreeProduct C G₁ G₂ where
  toFun x := Generation.closedSubgroupGeneratedMap
    (Construction.generators C G₁ G₂) (Sum.inr x)
  map_one' := Subtype.ext (Construction.evaluationRight C G₁ G₂).map_one
  map_mul' x y := Subtype.ext ((Construction.evaluationRight C G₁ G₂).map_mul x y)
  continuous_toFun := (Construction.evaluationRight C G₁ G₂).continuous.subtype_mk _

/-- The two factor maps topologically generate the constructed group. -/
theorem inl_inr_topologicallyGenerates :
    Generation.TopologicallyGenerates
      (Set.range (Sum.elim (inl C G₁ G₂ : G₁ → FreeProduct C G₁ G₂)
        (inr C G₁ G₂ : G₂ → FreeProduct C G₁ G₂))) := by
  have h := Generation.closedSubgroupGeneratedMap_topologicallyGenerates
    (Construction.generators C G₁ G₂)
  have heq :
      Generation.closedSubgroupGeneratedMap (Construction.generators C G₁ G₂) =
        Sum.elim (inl C G₁ G₂ : G₁ → FreeProduct C G₁ G₂)
          (inr C G₁ G₂ : G₂ → FreeProduct C G₁ G₂) := by
    funext x
    cases x <;> rfl
  rw [heq] at h
  exact h

/-- Maps from the construction to a Hausdorff group are determined by the two factors. -/
theorem freeProduct_hom_ext
    {K : Type v} [Group K] [TopologicalSpace K] [T2Space K]
    {f g : FreeProduct C G₁ G₂ →ₜ* K}
    (hl : f.comp (inl C G₁ G₂) = g.comp (inl C G₁ G₂))
    (hr : f.comp (inr C G₁ G₂) = g.comp (inr C G₁ G₂)) : f = g := by
  apply Generation.continuousMonoidHom_ext_of_topologicallyGenerates
    (inl_inr_topologicallyGenerates C G₁ G₂)
  rintro _ ⟨x, rfl⟩
  cases x with
  | inl x => exact DFunLike.congr_fun hl x
  | inr x => exact DFunLike.congr_fun hr x

/-- Projection to any finite continuous diagram. -/
def projection (d : Construction.FiniteDiagram C G₁ G₂) :
    FreeProduct C G₁ G₂ →ₜ* d.target where
  toFun x := x.val d
  map_one' := rfl
  map_mul' _ _ := rfl
  continuous_toFun := (continuous_apply d).comp continuous_subtype_val

/-- The left factor formula for a finite-stage projection. -/
@[simp] theorem projection_inl (d : Construction.FiniteDiagram C G₁ G₂) :
    (projection C G₁ G₂ d).comp (inl C G₁ G₂) = d.left := rfl

/-- The right factor formula for a finite-stage projection. -/
@[simp] theorem projection_inr (d : Construction.FiniteDiagram C G₁ G₂) :
    (projection C G₁ G₂ d).comp (inr C G₁ G₂) = d.right := rfl

/-- Coordinates satisfy every transition that respects both finite-diagram legs. -/
theorem projection_compatible
    (d e : Construction.FiniteDiagram C G₁ G₂) (f : d.target →ₜ* e.target)
    (hl : f.comp d.left = e.left) (hr : f.comp d.right = e.right) :
    f.comp (projection C G₁ G₂ d) = projection C G₁ G₂ e := by
  apply freeProduct_hom_ext C G₁ G₂
  · change f.comp ((projection C G₁ G₂ d).comp (inl C G₁ G₂)) =
      (projection C G₁ G₂ e).comp (inl C G₁ G₂)
    rw [projection_inl, projection_inl]
    exact hl
  · change f.comp ((projection C G₁ G₂ d).comp (inr C G₁ G₂)) =
      (projection C G₁ G₂ e).comp (inr C G₁ G₂)
    rw [projection_inr, projection_inr]
    exact hr

/-- Each native finite in-class extension problem is solved by an actual coordinate. -/
theorem existsUnique_lift_finite
    {H : Type u} [Group H] [TopologicalSpace H] [DiscreteTopology H] [Finite H]
    (hH : C H) (φ₁ : G₁ →ₜ* H) (φ₂ : G₂ →ₜ* H) :
    ∃! f : FreeProduct C G₁ G₂ →ₜ* H,
      f.comp (inl C G₁ G₂) = φ₁ ∧ f.comp (inr C G₁ G₂) = φ₂ := by
  classical
  obtain ⟨n, ⟨e⟩⟩ := Finite.exists_equiv_fin H
  let e' : H ≃ ULift.{u} (Fin n) := e.trans Equiv.ulift.symm
  let Q : Construction.FiniteModel.{u} := ⟨n, e'.symm.group⟩
  let eQ : Q ≃ₜ* H :=
    { e'.symm.mulEquiv with
      continuous_toFun := continuous_of_discreteTopology
      continuous_invFun := continuous_of_discreteTopology }
  let toQ : H →ₜ* Q := ContinuousMonoidHom.toContinuousMonoidHom eQ.symm
  let fromQ : Q →ₜ* H := ContinuousMonoidHom.toContinuousMonoidHom eQ
  let d : Construction.FiniteDiagram C G₁ G₂ :=
    { target := Q
      inClass := C.mem_of_mulEquiv eQ.toMulEquiv.symm hH
      left := toQ.comp φ₁
      right := toQ.comp φ₂ }
  let f : FreeProduct C G₁ G₂ →ₜ* H := fromQ.comp (projection C G₁ G₂ d)
  have hl : f.comp (inl C G₁ G₂) = φ₁ := by
    ext x
    exact eQ.apply_symm_apply (φ₁ x)
  have hr : f.comp (inr C G₁ G₂) = φ₂ := by
    ext x
    exact eQ.apply_symm_apply (φ₂ x)
  refine ⟨f, ⟨hl, hr⟩, ?_⟩
  intro g hg
  exact freeProduct_hom_ext C G₁ G₂ (hg.1.trans hl.symm) (hg.2.trans hr.symm)

/-- Formation and hereditary closure make the concrete closed generated subgroup pro-C. -/
theorem freeProduct_hasOpenNormalBasisInClass
    (hForm : FiniteGroupClass.Formation C) (hHer : FiniteGroupClass.Hereditary C) :
    ProC.HasOpenNormalBasisInClass C (FreeProduct C G₁ G₂) := by
  apply ProC.HasOpenNormalBasisInClass.of_closedSubgroup_pi
    (Gs := fun d : Construction.FiniteDiagram C G₁ G₂ => d.target)
    (H := (Construction.generatedSubgroup C G₁ G₂ :
      Subgroup (Construction.StageProduct C G₁ G₂)))
    (Construction.generatedSubgroup C G₁ G₂).isClosed' hForm hHer.subgroupClosed
  intro d
  exact ProC.HasOpenNormalBasisInClass.of_finite_discrete_mem d.inClass

/-- The concrete finite-diagram construction satisfies the binary free pro-C universal property. -/
theorem isFreeProCProduct
    (hForm : FiniteGroupClass.Formation C) (hHer : FiniteGroupClass.Hereditary C) :
    IsFreeProCProduct (C := C) (inl C G₁ G₂) (inr C G₁ G₂) where
  hasOpenNormalBasisInClass := freeProduct_hasOpenNormalBasisInClass C G₁ G₂ hForm hHer
  existsUnique_lift := by
    intro K _ _ _ _ _ _ hK φ₁ φ₂
    have hext := ProC.existsUnique_continuousExtension_of_finiteQuotients
      (C := C) (Sum.elim (inl C G₁ G₂ : G₁ → FreeProduct C G₁ G₂)
        (inr C G₁ G₂ : G₂ → FreeProduct C G₁ G₂))
      ((ProC.hasOpenNormalBasisInClassAcrossUniverses_iff (C := C)).2 hK)
      (Sum.elim (φ₁ : G₁ → K) (φ₂ : G₂ → K)) (by
        intro H _ _ _ _ hH q
        obtain ⟨f, hf, huniq⟩ :=
          existsUnique_lift_finite C G₁ G₂ hH (q.comp φ₁) (q.comp φ₂)
        refine ⟨f, ?_, ?_⟩
        · intro x
          cases x with
          | inl x => exact DFunLike.congr_fun hf.1 x
          | inr x => exact DFunLike.congr_fun hf.2 x
        · intro g hg
          apply huniq g
          constructor
          · ext x
            exact hg (Sum.inl x)
          · ext x
            exact hg (Sum.inr x))
    obtain ⟨f, hf, huniq⟩ := hext
    refine ⟨f, ⟨?_, ?_⟩, ?_⟩
    · ext x
      exact hf (Sum.inl x)
    · ext x
      exact hf (Sum.inr x)
    · intro g hg
      apply huniq g
      intro x
      cases x with
      | inl x => exact DFunLike.congr_fun hg.1 x
      | inr x => exact DFunLike.congr_fun hg.2 x

end ProCGroups.FreeProducts
