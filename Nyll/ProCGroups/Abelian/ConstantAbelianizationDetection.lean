/-!
# Detection by the original constant-stage abelianizations

The arithmetic subgroup at degree `n` is the actual closed subgroup generated
by the `n`-th power of the specified arithmetic generator. Marked maps restrict
to its literal inverse image. Equality on the topological abelianizations of
any divisibility-cofinal family of these inverse images determines the maps
on the full geometric kernel.

The remaining arithmetic discrepancy is a single original geometric inner
automorphism. Its conjugating element is extracted from the actual global
abelianization kernel, using the original full abelian comparison as well.
This additional comparison is necessary for a cofinal family, which can
miss finite arithmetic discrepancies. No equality of displacement kernels,
no equality on the geometric kernel, and no inner-conjugacy statement is an input.
-/

@[expose] public section

noncomputable section

open scoped IsMulCommutative

namespace ProCGroups.Abelian

open Generation

universe u v w

section Preimages

variable {P : Type u} [Group P] [TopologicalSpace P] [IsTopologicalGroup P]
    {Q : Type v} [Group Q] [TopologicalSpace Q] [IsTopologicalGroup Q]
    {Γ : Type w} [Group Γ] [TopologicalSpace Γ] [IsTopologicalGroup Γ]

/-- The actual arithmetic subgroup generated by the specified positive
power, retaining its original inclusion in the arithmetic group. -/
def arithmeticPowerSubgroup (γ : Γ) (n : ℕ+) : ClosedSubgroup Γ :=
  closedSubgroupGenerated (Set.range (fun _ : PUnit.{1} => γ ^ (n : ℕ)))

/-- A closed arithmetic subgroup with its actual power generator is the
specified arithmetic power subgroup. The original inclusion is retained. -/
theorem arithmeticPowerSubgroup_eq_of_generator
    (γ : Γ) (n : ℕ+) (H : ClosedSubgroup Γ) (δ : H.toSubgroup)
    (hδ : TopologicallyGenerates ({δ} : Set H.toSubgroup))
    (hval : δ.val = γ ^ (n : ℕ)) : arithmeticPowerSubgroup γ n = H := by
  have hle : (arithmeticPowerSubgroup γ n).toSubgroup ≤ H.toSubgroup := by
    change (Subgroup.closure
      (Set.range (fun _ : PUnit.{1} => γ ^ (n : ℕ)))).topologicalClosure ≤ H.toSubgroup
    apply Subgroup.topologicalClosure_minimal _ ?_ H.isClosed'
    rw [Subgroup.closure_le]
    rintro _ ⟨i, rfl⟩
    rw [← hval]
    exact δ.property
  have hge : H.toSubgroup ≤ (arithmeticPowerSubgroup γ n).toSubgroup := by
    intro z hz
    let zH : H.toSubgroup := ⟨z, hz⟩
    let ι : H.toSubgroup →ₜ* Γ :=
      { toMonoidHom := H.toSubgroup.subtype
        continuous_toFun := continuous_subtype_val }
    have hzgen : zH ∈ (closedSubgroupGenerated ({δ} : Set H.toSubgroup)).toSubgroup := by
      change zH ∈ (Subgroup.closure ({δ} : Set H.toSubgroup)).topologicalClosure
      rw [hδ]
      trivial
    have hi := map_mem_closedSubgroupGenerated_singleton ι δ hzgen
    change z ∈ (closedSubgroupGenerated ({δ.val} : Set Γ)).toSubgroup at hi
    have hset : ({δ.val} : Set Γ) =
        Set.range (fun _ : PUnit.{1} => γ ^ (n : ℕ)) := by
      ext w
      constructor
      · intro hw
        exact ⟨PUnit.unit, hval.symm.trans (Set.mem_singleton_iff.mp hw).symm⟩
      · rintro ⟨i, rfl⟩
        exact Set.mem_singleton_iff.mpr hval.symm
    rw [hset] at hi
    exact hi
  ext z
  exact ⟨fun hz => hle hz, fun hz => hge hz⟩

private def arithmeticPowerGenerator (γ : Γ) (n : ℕ+) :
    (arithmeticPowerSubgroup γ n).toSubgroup :=
  closedSubgroupGeneratedMap (fun _ : PUnit.{1} => γ ^ (n : ℕ)) PUnit.unit

private theorem arithmeticPowerGenerator_topologicallyGenerates (γ : Γ) (n : ℕ+) :
    TopologicallyGenerates
      ({arithmeticPowerGenerator γ n} : Set (arithmeticPowerSubgroup γ n).toSubgroup) := by
  have h := closedSubgroupGeneratedMap_topologicallyGenerates
    (fun _ : PUnit.{1} => γ ^ (n : ℕ))
  have hrange : Set.range (closedSubgroupGeneratedMap (fun _ : PUnit.{1} => γ ^ (n : ℕ))) =
      ({arithmeticPowerGenerator γ n} : Set (arithmeticPowerSubgroup γ n).toSubgroup) := by
    ext z
    constructor
    · rintro ⟨i, rfl⟩
      cases i
      rfl
    · intro hz
      exact ⟨PUnit.unit, (Set.mem_singleton_iff.mp hz).symm⟩
  exact hrange ▸ h

/-- A marked map induces the literal map of inverse images of the same
closed arithmetic subgroup. -/
def arithmeticPreimageMap
    (π : P →ₜ* Γ) (π' : Q →ₜ* Γ) (H : ClosedSubgroup Γ)
    (f : P →ₜ* Q) (hf : ∀ x, π' (f x) = π x) :
    H.toSubgroup.comap π.toMonoidHom →ₜ* H.toSubgroup.comap π'.toMonoidHom := by
  have hmem (x : H.toSubgroup.comap π.toMonoidHom) :
      f x.val ∈ H.toSubgroup.comap π'.toMonoidHom := by
    change π' (f x.val) ∈ H.toSubgroup
    exact (congrArg (fun z : Γ => z ∈ H.toSubgroup) (hf x.val)).mpr x.property
  exact
    { toMonoidHom :=
        { toFun := fun x => ⟨f x.val, hmem x⟩
          map_one' := Subtype.ext f.map_one
          map_mul' := fun x y => Subtype.ext (f.map_mul x.val y.val) }
      continuous_toFun := (f.continuous.comp continuous_subtype_val).subtype_mk hmem }

private def arithmeticPreimageProjection
    (π : P →ₜ* Γ) (H : ClosedSubgroup Γ) :
    H.toSubgroup.comap π.toMonoidHom →ₜ* H.toSubgroup :=
  { toFun := fun x => ⟨π x.val, x.property⟩
    map_one' := Subtype.ext π.map_one
    map_mul' := fun x y => Subtype.ext (π.map_mul x.val y.val)
    continuous_toFun := (π.continuous.comp continuous_subtype_val).subtype_mk _ }

private def arithmeticKernelIntoPreimage
    (π : P →ₜ* Γ) (H : ClosedSubgroup Γ) :
    π.toMonoidHom.ker →* H.toSubgroup.comap π.toMonoidHom :=
  { toFun := fun a => ⟨a.val, by
      change π a.val ∈ H.toSubgroup
      have ha : π a.val = 1 := a.property
      rw [ha]
      exact H.toSubgroup.one_mem⟩
    map_one' := rfl
    map_mul' := fun _ _ => rfl }

end Preimages

private local instance compactContinuousKernel
    {E : Type u} [Group E] [TopologicalSpace E] [CompactSpace E]
    {B : Type w} [Group B] [TopologicalSpace B] [T2Space B] (π : E →ₜ* B) :
    CompactSpace π.toMonoidHom.ker := by
  apply isCompact_iff_compactSpace.mp
  change IsCompact {x : E | π x = 1}
  exact (isClosed_eq π.continuous continuous_const).isCompact

section StageKernel

variable {Q : Type v} [Group Q] [TopologicalSpace Q] [IsTopologicalGroup Q]
    [CompactSpace Q] [T2Space Q]
    {Γ : Type w} [Group Γ] [TopologicalSpace Γ] [IsTopologicalGroup Γ] [T2Space Γ]

private theorem mem_displacement_of_preimage_abelianization_eq_one
    (π : Q →ₜ* Γ) [IsMulCommutative π.toMonoidHom.ker]
    (s : Γ →ₜ* Q) (hs : ∀ g, π (s g) = g)
    (H : ClosedSubgroup Γ) (γ : H.toSubgroup)
    (hγ : TopologicallyGenerates ({γ} : Set H.toSubgroup))
    (a : π.toMonoidHom.ker)
    (ha : TopologicalAbelianization.mk (H.toSubgroup.comap π.toMonoidHom)
      (arithmeticKernelIntoPreimage π H a) = 1) :
    a.val ∈ conjugationDifferenceImage π.toMonoidHom.ker (s γ.val) := by
  let E := H.toSubgroup.comap π.toMonoidHom
  let ρ : E →ₜ* H.toSubgroup := arithmeticPreimageProjection π H
  have : CompactSpace E := isCompact_iff_compactSpace.mp
    (H.isClosed'.preimage π.continuous).isCompact
  have : IsMulCommutative ρ.toMonoidHom.ker := IsMulCommutative.of_comm fun x y => by
    apply Subtype.ext
    apply Subtype.ext
    let xA : π.toMonoidHom.ker := ⟨x.val.val, congrArg Subtype.val x.property⟩
    let yA : π.toMonoidHom.ker := ⟨y.val.val, congrArg Subtype.val y.property⟩
    exact congrArg (fun z : π.toMonoidHom.ker => z.val) (mul_comm xA yA)
  have htmem (g : H.toSubgroup) : s g.val ∈ E := by
    change π (s g.val) ∈ H.toSubgroup
    exact (congrArg (fun z : Γ => z ∈ H.toSubgroup) (hs g.val)).mpr g.property
  let t : H.toSubgroup →ₜ* E :=
    { toFun := fun g => ⟨s g.val, htmem g⟩
      map_one' := Subtype.ext s.map_one
      map_mul' := fun g h => Subtype.ext (s.map_mul g.val h.val)
      continuous_toFun := (s.continuous.comp continuous_subtype_val).subtype_mk htmem }
  have ht (g : H.toSubgroup) : ρ (t g) = g := Subtype.ext (hs g.val)
  let aE : ρ.toMonoidHom.ker :=
    ⟨arithmeticKernelIntoPreimage π H a, Subtype.ext a.property⟩
  have hkernel := abelianization_restrict_kernel_eq_conjugationDifference_range
    ρ t ht γ hγ
  have haE : aE ∈ ((TopologicalAbelianization.mk E).comp ρ.toMonoidHom.ker.subtype).ker := ha
  rw [hkernel] at haE
  obtain ⟨b, hb⟩ := haE
  let bA : π.toMonoidHom.ker := ⟨b.val.val, congrArg Subtype.val b.property⟩
  exact ⟨bA, congrArg (fun z : ρ.toMonoidHom.ker => z.val.val) hb⟩

end StageKernel

section Detection

variable {P : Type u} [Group P] [TopologicalSpace P] [IsTopologicalGroup P]
    {Q : Type v} [Group Q] [TopologicalSpace Q] [IsTopologicalGroup Q]
    [CompactSpace Q] [T2Space Q] [TotallyDisconnectedSpace Q]
    {Γ : Type w} [Group Γ] [TopologicalSpace Γ] [IsTopologicalGroup Γ] [T2Space Γ]
    (π : P →ₜ* Γ) (π' : Q →ₜ* Γ) [IsMulCommutative π'.toMonoidHom.ker]
    (s : Γ →ₜ* P) (hs : ∀ g, π (s g) = g)
    (γ : Γ) (hγ : TopologicallyGenerates ({γ} : Set Γ))
    (f g : P →ₜ* Q) (hf : ∀ x, π' (f x) = π x) (hg : ∀ x, π' (g x) = π x)

include hs in
/-- A family of actual constant-stage abelianizations whose degrees are
cofinal for divisibility determines the original geometric map exactly.
Only stages in the specified family are used. -/
theorem markedHoms_geometric_eq_of_cofinalPowerAbelianizations
    {ι : Type*} (degree : ι → ℕ+)
    (hcofinal : ∀ n : ℕ+, ∃ i, (n : ℕ) ∣ (degree i : ℕ))
    (hab : ∀ i,
      TopologicalAbelianization.map
          (arithmeticPreimageMap π π' (arithmeticPowerSubgroup γ (degree i)) f hf) =
        TopologicalAbelianization.map
          (arithmeticPreimageMap π π' (arithmeticPowerSubgroup γ (degree i)) g hg)) :
    ∀ a : π.toMonoidHom.ker, f a.val = g a.val := by
  let A := π'.toMonoidHom.ker
  let t : Γ →ₜ* Q := f.comp s
  have ht (z : Γ) : π' (t z) = z := (hf (s z)).trans (hs z)
  intro a
  let δ : A := ⟨g a.val / f a.val, by
    change π' (g a.val / f a.val) = 1
    rw [map_div, hg, hf, div_self']⟩
  have hstage (i : ι) :
      δ.val ∈ conjugationDifferenceImage A ((t γ) ^ (degree i : ℕ)) := by
    let H := arithmeticPowerSubgroup γ (degree i)
    let aH := arithmeticKernelIntoPreimage π H a
    have heq := DFunLike.congr_fun (hab i)
      (TopologicalAbelianization.mk (H.toSubgroup.comap π.toMonoidHom) aH)
    change TopologicalAbelianization.mk (H.toSubgroup.comap π'.toMonoidHom)
        (arithmeticPreimageMap π π' H f hf aH) =
      TopologicalAbelianization.mk (H.toSubgroup.comap π'.toMonoidHom)
        (arithmeticPreimageMap π π' H g hg aH) at heq
    have hzero : TopologicalAbelianization.mk (H.toSubgroup.comap π'.toMonoidHom)
        (arithmeticKernelIntoPreimage π' H δ) = 1 := by
      change TopologicalAbelianization.mk (H.toSubgroup.comap π'.toMonoidHom)
        (arithmeticPreimageMap π π' H g hg aH /
          arithmeticPreimageMap π π' H f hf aH) = 1
      rw [map_div]
      exact div_eq_one.mpr heq.symm
    have hd := mem_displacement_of_preimage_abelianization_eq_one
      π' t ht H (arithmeticPowerGenerator γ (degree i))
      (arithmeticPowerGenerator_topologicallyGenerates γ (degree i)) δ hzero
    change δ.val ∈ conjugationDifferenceImage A (t (γ ^ (degree i : ℕ))) at hd
    rw [map_pow] at hd
    exact hd
  have hδ (n : ℕ+) : δ.val ∈ conjugationDifferenceImage A ((t γ) ^ (n : ℕ)) := by
    obtain ⟨i, m, hm⟩ := hcofinal n
    have hi := hstage i
    rw [hm, pow_mul] at hi
    exact conjugationDifferenceImage_pow_le A ((t γ) ^ (n : ℕ)) m hi
  have hbot : (⊥ : Subgroup Q) =
      ⨅ n : ℕ+, (⊥ : Subgroup Q) ⊔ conjugationDifferenceImage A ((t γ) ^ (n : ℕ)) :=
    closedSubgroup_eq_iInf_sup_conjugationDifferenceImage A ⊥
      (show IsClosed ((⊥ : Subgroup Q) : Set Q) from isClosed_singleton) (t γ)
  have hδbot : δ.val ∈ (⊥ : Subgroup Q) := by
    rw [hbot]
    exact Subgroup.mem_iInf.mpr fun n => Subgroup.mem_sup_right (hδ n)
  exact (div_eq_one.mp hδbot).symm

omit [IsTopologicalGroup P] [TotallyDisconnectedSpace Q] in
include hs hγ hf hg in
private theorem markedHoms_inner_of_geometric_eq_and_generatorAbelianization
    (hgeom : ∀ a : π.toMonoidHom.ker, f a.val = g a.val)
    (hglobal : TopologicalAbelianization.mk Q (f (s γ)) =
      TopologicalAbelianization.mk Q (g (s γ))) :
    ∃ b : π'.toMonoidHom.ker, ∀ x : P,
      g x = b.val⁻¹ * f x * b.val := by
  let A := π'.toMonoidHom.ker
  let t : Γ →ₜ* Q := f.comp s
  have ht (z : Γ) : π' (t z) = z := (hf (s z)).trans (hs z)
  let δ : A := ⟨g (s γ) / f (s γ), by
    change π' (g (s γ) / f (s γ)) = 1
    rw [map_div, hg, hf, div_self']⟩
  have hδ : δ ∈ ((TopologicalAbelianization.mk Q).comp A.subtype).ker := by
    change TopologicalAbelianization.mk Q (g (s γ) / f (s γ)) = 1
    rw [map_div, hglobal, div_self']
  rw [abelianization_restrict_kernel_eq_conjugationDifference_range π' t ht γ hγ] at hδ
  obtain ⟨b, hb⟩ := hδ
  have hdisplacement :
      f (s γ) * b.val * (f (s γ))⁻¹ / b.val = g (s γ) / f (s γ) :=
    congrArg Subtype.val hb
  have hcomm : f (s γ) * b.val * (f (s γ))⁻¹ * b.val⁻¹ =
      b.val⁻¹ * (f (s γ) * b.val * (f (s γ))⁻¹) :=
    congrArg Subtype.val (mul_comm (MulAut.conjNormal (f (s γ)) b) b⁻¹)
  have hgenerator : g (s γ) = b.val⁻¹ * f (s γ) * b.val := by
    have hright := hdisplacement.symm.trans
      ((div_eq_mul_inv (f (s γ) * b.val * (f (s γ))⁻¹) b.val).trans hcomm)
    have h := congrArg (fun z : Q => z * f (s γ)) hright
    simpa only [div_eq_mul_inv, mul_assoc, inv_mul_cancel, mul_one] using h
  let c : Q →ₜ* Q :=
    { toMonoidHom := (MulAut.conj b.val⁻¹).toMonoidHom
      continuous_toFun := (continuous_const.mul continuous_id).mul continuous_const }
  have hsection : g.comp s = c.comp (f.comp s) := by
    apply continuousMonoidHom_ext_of_topologicallyGenerates hγ
    intro z hz
    have hzγ := Set.mem_singleton_iff.mp hz
    subst z
    change g (s γ) = b.val⁻¹ * f (s γ) * (b.val⁻¹)⁻¹
    rw [inv_inv]
    exact hgenerator
  have hsection_apply (z : Γ) : g (s z) = b.val⁻¹ * f (s z) * b.val := by
    have h := DFunLike.congr_fun hsection z
    change g (s z) = b.val⁻¹ * f (s z) * (b.val⁻¹)⁻¹ at h
    rw [inv_inv] at h
    exact h
  refine ⟨b, fun x => ?_⟩
  let a : π.toMonoidHom.ker := ⟨x / s (π x), by
    change π (x / s (π x)) = 1
    rw [map_div, hs, div_self']⟩
  have hdecomp : a.val * s (π x) = x := div_mul_cancel x (s (π x))
  let fa : A := ⟨f a.val, by
    change π' (f a.val) = 1
    exact (hf a.val).trans a.property⟩
  have hcommute : f a.val * b.val⁻¹ = b.val⁻¹ * f a.val :=
    congrArg Subtype.val (mul_comm fa b⁻¹)
  calc
    g x = g (a.val * s (π x)) := congrArg g hdecomp.symm
    _ = g a.val * g (s (π x)) := map_mul g _ _
    _ = f a.val * (b.val⁻¹ * f (s (π x)) * b.val) := by
      rw [← hgeom a, hsection_apply]
    _ = (f a.val * b.val⁻¹) * (f (s (π x)) * b.val) := by group
    _ = (b.val⁻¹ * f a.val) * (f (s (π x)) * b.val) := by rw [hcommute]
    _ = b.val⁻¹ * (f a.val * f (s (π x))) * b.val := by group
    _ = b.val⁻¹ * f x * b.val := by rw [← map_mul, hdecomp]

include hs hγ in
/-- Cofinal constant-stage abelianizations, together with the original
full abelianization, determine the marked map up to a single original
geometric inner automorphism. Cofinal stage comparisons alone determine
only the geometric map: they can miss a finite arithmetic discrepancy,
even for abelian groups. The additional original abelian comparison
removes exactly that discrepancy. -/
theorem markedHoms_geometric_eq_and_inner_of_cofinalPowerAbelianizations
    {ι : Type*} (degree : ι → ℕ+)
    (hcofinal : ∀ n : ℕ+, ∃ i, (n : ℕ) ∣ (degree i : ℕ))
    (hab : ∀ i,
      TopologicalAbelianization.map
          (arithmeticPreimageMap π π' (arithmeticPowerSubgroup γ (degree i)) f hf) =
        TopologicalAbelianization.map
          (arithmeticPreimageMap π π' (arithmeticPowerSubgroup γ (degree i)) g hg))
    (hab0 : TopologicalAbelianization.map f = TopologicalAbelianization.map g) :
    (∀ a : π.toMonoidHom.ker, f a.val = g a.val) ∧
      ∃ b : π'.toMonoidHom.ker, ∀ x : P,
        g x = b.val⁻¹ * f x * b.val := by
  have hgeom := markedHoms_geometric_eq_of_cofinalPowerAbelianizations
    π π' s hs γ f g hf hg degree hcofinal hab
  refine ⟨hgeom, ?_⟩
  have hglobal := DFunLike.congr_fun hab0 (TopologicalAbelianization.mk P (s γ))
  change TopologicalAbelianization.mk Q (f (s γ)) =
    TopologicalAbelianization.mk Q (g (s γ)) at hglobal
  exact markedHoms_inner_of_geometric_eq_and_generatorAbelianization
    π π' s hs γ hγ f g hf hg hgeom hglobal

include hs hγ in
/-- The actual abelian maps of all constant stages determine the full
geometric map exactly and the full marked map up to one inner geometric
automorphism. The same original arithmetic projection is retained. -/
theorem markedHoms_geometric_eq_and_inner_of_powerAbelianizations
    (hab : ∀ n : ℕ+,
      TopologicalAbelianization.map
          (arithmeticPreimageMap π π' (arithmeticPowerSubgroup γ n) f hf) =
        TopologicalAbelianization.map
          (arithmeticPreimageMap π π' (arithmeticPowerSubgroup γ n) g hg)) :
    (∀ a : π.toMonoidHom.ker, f a.val = g a.val) ∧
      ∃ b : π'.toMonoidHom.ker, ∀ x : P,
        g x = b.val⁻¹ * f x * b.val := by
  have hgeom := markedHoms_geometric_eq_of_cofinalPowerAbelianizations
    π π' s hs γ f g hf hg (fun n : ℕ+ => n) (fun n => ⟨n, dvd_refl _⟩) hab
  refine ⟨hgeom, ?_⟩
  let H := arithmeticPowerSubgroup γ (1 : ℕ+)
  have hγH : γ ∈ H.toSubgroup := by
    have h := (arithmeticPowerGenerator γ (1 : ℕ+)).property
    change γ ^ (1 : ℕ) ∈ H.toSubgroup at h
    rw [pow_one] at h
    exact h
  let d : H.toSubgroup.comap π.toMonoidHom := ⟨s γ, by
    change π (s γ) ∈ H.toSubgroup
    rw [hs]
    exact hγH⟩
  have heq := DFunLike.congr_fun (hab (1 : ℕ+))
    (TopologicalAbelianization.mk (H.toSubgroup.comap π.toMonoidHom) d)
  let ι : H.toSubgroup.comap π'.toMonoidHom →ₜ* Q :=
    { toMonoidHom := (H.toSubgroup.comap π'.toMonoidHom).subtype
      continuous_toFun := continuous_subtype_val }
  have hglobal := congrArg (TopologicalAbelianization.map ι) heq
  change TopologicalAbelianization.mk Q (f (s γ)) =
    TopologicalAbelianization.mk Q (g (s γ)) at hglobal
  exact markedHoms_inner_of_geometric_eq_and_generatorAbelianization
    π π' s hs γ hγ f g hf hg hgeom hglobal

end Detection

end ProCGroups.Abelian
